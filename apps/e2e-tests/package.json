{
  "name": "@run-event/e2e-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:registration:dev": "node test/registration.test.js --mode dev",
    "test:registration:prod": "node test/registration.test.js --mode prod",
    "test:auth:dev": "node test/authentication.test.js --mode dev",
    "test:auth:prod": "node test/authentication.test.js --mode prod",
    "test:dev": "npm run test:registration:dev && npm run test:auth:dev",
    "test:prod": "npm run test:registration:prod && npm run test:auth:prod"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "selenium-webdriver": "^4.46.0"
  }
}
